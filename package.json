{
  "name": "fleet-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.18.0"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel --stream dev",
    "build": "pnpm --recursive build",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint && pnpm format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm --recursive exec rm -rf dist coverage node_modules/.tmp"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~6.0.2"
  }
}
