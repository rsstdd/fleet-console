{
  "name": "@fleet/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Thin runtime authority: telemetry ingest, adapter dispatch, in-memory fleet state, freshness sweep, HTTP reads, WebSocket delta fan-out, health.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "pnpm lint:js && pnpm typecheck",
    "lint:js": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fleet/adapters": "workspace:*",
    "@fleet/contracts": "workspace:*",
    "@hono/node-server": "^2.1.0",
    "hono": "^4.13.1",
    "ws": "^8.21.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "globals": "^17.11.0",
    "tsx": "^4.20.6",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
