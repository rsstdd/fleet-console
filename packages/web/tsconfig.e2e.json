{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    // Playwright tests run under Node with DOM types only inside page.evaluate
    // callbacks, which Playwright serializes into the browser; DOM lib covers those.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    // Executed by Playwright's own transform under Node resolution rules, like
    // vite.config.ts is by Node itself (see tsconfig.node.json).
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true
  },
  "include": ["e2e", "playwright.config.ts"]
}
