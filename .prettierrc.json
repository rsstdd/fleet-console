{
  "printWidth": 100,
  "singleQuote": false,
  "trailingComma": "all",
  "semi": true,
  "overrides": [
    {
      "files": ["*.md"],
      "options": {
        "proseWrap": "preserve"
      }
    },
    {
      "files": ["packages/adapters/src/vendors/*/__fixtures__/*.json"],
      "options": {
        "objectWrap": "collapse"
      }
    }
  ]
}
